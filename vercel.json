{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": null,
    "regions": [
        "sin1"
    ],
    "installCommand": "echo Dependensi PHP dipasang oleh vercel-php",
    "buildCommand": "echo Aset CSS/JS sudah dibuild di laptop dengan npm run build",
    "outputDirectory": "public",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.7.4"
        }
    },
    "routes": [
        {
            "src": "/build/(.*)",
            "dest": "/build/$1"
        },
        {
            "src": "/(audio|images)/(.*)",
            "dest": "/$1/$2"
        },
        {
            "src": "/(favicon\\.ico|robots\\.txt)",
            "dest": "/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ]
}
